<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SpeakForever.Gui.Controls.LogoView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Only opacity is animated: it runs on the compositor, not the UI thread.
             Played while listening, and at a higher SpeedRatio while transcribing; stopped otherwise. -->
        <Storyboard x:Name="Pulse">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Highlight" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.2" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.8" Value="1" />
                <LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="0.2" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </UserControl.Resources>

    <!-- Same drawing as assets/logo.svg: an infinity sign in chat brackets, orange with a black outline, on a 128 x 128 canvas.
         Strokes are the heavier small-size ones, since it shows at title-bar size. -->
    <Viewbox>
        <Canvas Width="128" Height="128">
            <Path Stroke="#000000" StrokeThickness="22" StrokeStartLineCap="Square" StrokeEndLineCap="Square" Data="M34,22 H18 V106 H34" />
            <Path Stroke="#000000" StrokeThickness="22" StrokeStartLineCap="Square" StrokeEndLineCap="Square" Data="M94,22 H110 V106 H94" />
            <Path Stroke="#000000" StrokeThickness="22" Data="M64,64 C72,48 92,48 92,64 C92,80 72,80 64,64 C56,48 36,48 36,64 C36,80 56,80 64,64 Z" />
            <Path Stroke="#FF8000" StrokeThickness="14" StrokeStartLineCap="Square" StrokeEndLineCap="Square" Data="M34,22 H18 V106 H34" />
            <Path Stroke="#FF8000" StrokeThickness="14" StrokeStartLineCap="Square" StrokeEndLineCap="Square" Data="M94,22 H110 V106 H94" />
            <Path Stroke="#FF8000" StrokeThickness="14" Data="M64,64 C72,48 92,48 92,64 C92,80 72,80 64,64 C56,48 36,48 36,64 C36,80 56,80 64,64 Z" />
            <!-- Lit while it listens and transcribes. -->
            <Path x:Name="Highlight" Stroke="#FFFFFF" StrokeThickness="5" Opacity="0"
                  Data="M64,64 C72,48 92,48 92,64 C92,80 72,80 64,64 C56,48 36,48 36,64 C36,80 56,80 64,64 Z" />
        </Canvas>
    </Viewbox>
</UserControl>
