<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SpeakForever.Gui.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SpeakForever.Gui.Controls"
    xmlns:models="using:SpeakForever.Gui.Models"
    xmlns:presentation="using:SpeakForever.Presentation"
    Title="Speak Forever">

    <Grid x:Name="Root" Background="{StaticResource WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar: the window's caption buttons sit over its right edge. -->
        <Grid x:Name="TitleBar" Height="64" Padding="18,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <controls:LogoView x:Name="Logo" Width="42" Height="42" />
                <TextBlock Text="Speak Forever" FontFamily="{StaticResource Cinzel}" FontSize="24" FontWeight="SemiBold"
                           Foreground="{StaticResource StarlightBrush}" CharacterSpacing="60" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Height="9" Margin="24,0">
            <Rectangle Height="1" VerticalAlignment="Center">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="Transparent" Offset="0" />
                        <GradientStop Color="#8A93B8" Offset="0.5" />
                        <GradientStop Color="Transparent" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Width="7" Height="7" Fill="{StaticResource SilverBrush}" RenderTransformOrigin="0.5,0.5">
                <Rectangle.RenderTransform><RotateTransform Angle="45" /></Rectangle.RenderTransform>
            </Rectangle>
        </Grid>

        <Grid Grid.Row="2" Padding="22,10,22,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="12" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Foreground="{StaticResource ArcaneBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <ToggleSwitch x:Name="ActiveSwitch" Grid.Column="1" MinWidth="0"
                              OnContent="Active" OffContent="Paused" Toggled="ActiveSwitch_Toggled" />
            </Grid>

            <SelectorBar x:Name="Tabs" Grid.Row="1" Margin="-12,0,0,4" SelectionChanged="Tabs_SelectionChanged">
                <SelectorBarItem Text="Dictation" FontFamily="{StaticResource Cinzel}" IsSelected="True" />
                <SelectorBarItem Text="Speech model" FontFamily="{StaticResource Cinzel}" />
                <SelectorBarItem Text="Buttons &amp; shortcuts" FontFamily="{StaticResource Cinzel}" />
                <SelectorBarItem Text="Settings" FontFamily="{StaticResource Cinzel}" />
            </SelectorBar>

            <!-- Dictation: the log fills whatever height the window has. -->
            <Grid x:Name="DictationPage" Grid.Row="2" RowSpacing="14" Padding="0,8,0,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- What needs attention first: the game not found, no speech model, an update. -->
                <StackPanel Spacing="14">
                    <controls:Notice x:Name="GameNotice" Glyph="&#xE7FC;" Visibility="Collapsed" ActionClick="GameNotice_ActionClick" />
                    <controls:Notice x:Name="ModelNotice" Glyph="&#xE896;" Visibility="Collapsed" ActionClick="ModelNotice_ActionClick" />
                    <controls:Notice x:Name="UpdateNotice" Glyph="&#xE777;" Visibility="Collapsed" ActionClick="DownloadUpdate_Click" />
                </StackPanel>
                <ContentControl Grid.Row="1" Style="{StaticResource Frame}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Last heard" Style="{StaticResource FrameHeader}" />
                        <TextBlock x:Name="LastHeardText" FontSize="15" Foreground="{StaticResource StarlightBrush}"
                                   TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <TextBlock x:Name="LastHeardMeta" Style="{StaticResource Caption}" />
                    </StackPanel>
                </ContentControl>
                <ContentControl Grid.Row="2" Style="{StaticResource Frame}" Padding="12,10,12,12">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Text="Activity" Margin="4,0" Style="{StaticResource FrameHeader}" />
                        <!-- Styled like a WoW chat frame. -->
                        <Border Grid.Row="1" Background="{StaticResource ChatBrush}" BorderBrush="{StaticResource IndigoBrush}" BorderThickness="1" CornerRadius="2">
                            <ListView x:Name="LogList" SelectionMode="None" Padding="0,4">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                        <Setter Property="MinHeight" Value="0" />
                                        <Setter Property="Padding" Value="10,1" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:LogLine">
                                        <TextBlock Text="{x:Bind Text}" Foreground="{x:Bind Brush}" TextWrapping="Wrap"
                                                   FontFamily="Cascadia Mono, Consolas" FontSize="12" IsTextSelectionEnabled="True" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>
                    </Grid>
                </ContentControl>
            </Grid>

            <ScrollViewer x:Name="ModelPage" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="0,8,0,22">
                <ContentControl Style="{StaticResource Frame}">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Speech model" Style="{StaticResource FrameHeader}" VerticalAlignment="Center" />
                            <Button x:Name="TestMicButton" Grid.Column="1" Style="{StaticResource PanelButton}"
                                    Click="TestMicButton_Click" AutomationProperties.Name="Test microphone">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE720;" FontSize="14" />
                                    <TextBlock Text="Test microphone" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock x:Name="ModelStatusText" Style="{StaticResource Caption}" />
                        <!-- Filled in code: one row per downloadable model, plus any the user added. -->
                        <ItemsControl x:Name="ModelList" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="presentation:ModelRow">
                                    <StackPanel>
                                        <Rectangle Height="1" Fill="{StaticResource IndigoBrush}" Visibility="{x:Bind HasDivider, Mode=OneWay}" />
                                        <Grid ColumnSpacing="12" Padding="0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{x:Bind Name}" FontSize="15" Foreground="{StaticResource StarlightBrush}" VerticalAlignment="Center" />
                                                    <Border Visibility="{x:Bind IsRecommended}" Background="#2E3F8F" BorderBrush="{StaticResource SilverBrush}"
                                                            BorderThickness="1" CornerRadius="3" Padding="6,1,6,2" VerticalAlignment="Center">
                                                        <TextBlock Text="Recommended" FontSize="11" FontFamily="{StaticResource Cinzel}" Foreground="{StaticResource StarlightBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind Summary}" Style="{StaticResource Caption}" Foreground="{StaticResource ArcaneBrush}" />
                                                <TextBlock Text="{x:Bind Blurb}" Style="{StaticResource Caption}" Visibility="{x:Bind HasBlurb}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <ProgressBar Width="130" Maximum="1" Value="{x:Bind Progress, Mode=OneWay}" VerticalAlignment="Center"
                                                             Visibility="{x:Bind ShowProgress, Mode=OneWay}" />
                                                <TextBlock Text="{x:Bind ProgressText, Mode=OneWay}" MinWidth="38" Foreground="{StaticResource ArcaneBrush}" VerticalAlignment="Center"
                                                           Visibility="{x:Bind ShowProgress, Mode=OneWay}" />
                                                <Button Content="Cancel" Style="{StaticResource PanelButton}" Click="CancelDownload_Click"
                                                        Visibility="{x:Bind ShowProgress, Mode=OneWay}" />
                                                <TextBlock Text="{x:Bind StateLabel, Mode=OneWay}" FontFamily="{StaticResource Cinzel}" FontWeight="SemiBold"
                                                           Foreground="{StaticResource ArcaneBrush}" VerticalAlignment="Center" Visibility="{x:Bind ShowStatus, Mode=OneWay}" />
                                                <Button Content="Use" Style="{StaticResource PanelButton}" Click="UseModel_Click"
                                                        IsEnabled="{x:Bind CanUse, Mode=OneWay}" Visibility="{x:Bind ShowUse, Mode=OneWay}" />
                                                <Button Style="{StaticResource PanelButton}" MinWidth="0" Click="DeleteModel_Click" Visibility="{x:Bind ShowUse, Mode=OneWay}"
                                                        ToolTipService.ToolTip="{x:Bind DeleteLabel}" AutomationProperties.Name="{x:Bind DeleteLabel}">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                                </Button>
                                                <Button Content="Download" Style="{StaticResource PanelButton}" Click="DownloadModel_Click"
                                                        Visibility="{x:Bind ShowDownload, Mode=OneWay}" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid ColumnSpacing="12" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Stop listening after a pause of" VerticalAlignment="Center" />
                            <Slider x:Name="PauseSlider" Grid.Column="1" Minimum="0.5" Maximum="4" StepFrequency="0.1"
                                    VerticalAlignment="Center" AutomationProperties.Name="Pause before it stops listening" />
                            <TextBlock x:Name="PauseText" Grid.Column="2" MinWidth="36" VerticalAlignment="Center" Foreground="{StaticResource ArcaneBrush}" />
                        </Grid>
                        <TextBlock x:Name="PauseHint" Style="{StaticResource Caption}" />
                    </StackPanel>
                </ContentControl>
                </StackPanel>
            </ScrollViewer>

            <!-- A tab stop so recording a keyboard shortcut can move focus off the buttons (Space would press them). -->
            <ScrollViewer x:Name="ButtonsPage" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" IsTabStop="True">
                <StackPanel Padding="0,8,0,22">
                <ContentControl Style="{StaticResource Frame}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Buttons &amp; shortcuts" Style="{StaticResource FrameHeader}" />
                        <Grid ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Open chat (controller)" />
                                <TextBlock Style="{StaticResource Caption}"
                                           Text="The combo WoW uses to open chat. If you rebind it in game, set it here to match. Opening Chat from the radial menu works too." />
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource Keycap}">
                                <TextBlock x:Name="OpenChatText" Style="{StaticResource KeycapText}" />
                            </Border>
                            <Button x:Name="OpenChatButton" Grid.Column="2" Content="Change" Style="{StaticResource PanelButton}" Click="OpenChatButton_Click" />

                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                <TextBlock Text="Dictate (controller)" />
                                <TextBlock Style="{StaticResource Caption}" Text="Press while chat is open, then speak." />
                            </StackPanel>
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Keycap}">
                                <TextBlock x:Name="DictateText" Style="{StaticResource KeycapText}" />
                            </Border>
                            <Button x:Name="DictateButton" Grid.Row="1" Grid.Column="2" Content="Change" Style="{StaticResource PanelButton}" Click="DictateButton_Click" />

                            <StackPanel Grid.Row="2" VerticalAlignment="Center">
                                <TextBlock Text="Dictate (keyboard)" />
                                <TextBlock x:Name="KeyboardCaption" Style="{StaticResource Caption}"
                                           Text="Optional. Dictates into whatever text box has focus, in any program, like Win+H. Press it again to finish early." />
                            </StackPanel>
                            <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource Keycap}">
                                <TextBlock x:Name="KeyboardText" Style="{StaticResource KeycapText}" />
                            </Border>
                            <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                <Button x:Name="KeyboardButton" Content="Change" Style="{StaticResource PanelButton}" Click="KeyboardButton_Click" />
                                <Button x:Name="KeyboardOffButton" Content="Turn off" Style="{StaticResource PanelButton}" Click="KeyboardOffButton_Click" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="BindingMessage" Style="{StaticResource Caption}" Visibility="Collapsed" />
                    </StackPanel>
                </ContentControl>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="SettingsPage" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="0,8,0,22" Spacing="14">
                    <ContentControl Style="{StaticResource Frame}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="WoW: Forever" Style="{StaticResource FrameHeader}" />
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                       Text="Speak Forever only ever types into the game, so it needs to know where the game is installed. It looks where Battle.net installs WoW when it first runs." />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="GameFolderText" Foreground="{StaticResource StarlightBrush}" VerticalAlignment="Center"
                                           TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="FindGameButton" Content="Find it" Style="{StaticResource PanelButton}" Click="FindGameButton_Click" />
                                    <Button x:Name="ChooseGameButton" Content="Choose folder" Style="{StaticResource PanelButton}" Click="ChooseGameButton_Click" />
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="GameMessage" Style="{StaticResource Caption}" TextWrapping="Wrap" Visibility="Collapsed" />
                        </StackPanel>
                    </ContentControl>

                    <ContentControl Style="{StaticResource Frame}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Updates" Style="{StaticResource FrameHeader}" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="VersionText" Foreground="{StaticResource StarlightBrush}" />
                                    <TextBlock x:Name="UpdateStatusText" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="DownloadUpdateButton" Content="Download" Style="{StaticResource PanelButton}" Visibility="Collapsed" Click="DownloadUpdate_Click" />
                                    <Button x:Name="CheckUpdatesButton" Content="Check for updates" Style="{StaticResource PanelButton}" Click="CheckUpdatesButton_Click" />
                                </StackPanel>
                            </Grid>
                            <ToggleSwitch x:Name="AutoUpdateSwitch" OnContent="Check automatically, at launch and every 6 hours"
                                          OffContent="Check automatically, at launch and every 6 hours" Toggled="AutoUpdateSwitch_Toggled" />
                        </StackPanel>
                    </ContentControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
