<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="SpeakForever.Gui.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Stock controls, recoloured to match. -->
            <!-- The Active switch: Guild green when on, like "Ready". -->
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#40FF40" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#73FF73" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#30D030" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#40FF40" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#73FF73" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#000000" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#000000" />
            <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#0A0A0C" />
            <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#222228" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#8C8C99" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#9D9D9D" />
            <SolidColorBrush x:Key="ToggleSwitchContentForeground" Color="#FFFFFF" />

            <SolidColorBrush x:Key="ComboBoxBackground" Color="#0A0A0C" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#222228" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#0A0A0C" />
            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#8C8C99" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxForeground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#0D0D1C" />
            <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#8C8C99" />

            <SolidColorBrush x:Key="SliderTrackFill" Color="#2E2E36" />
            <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#3A3A44" />
            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#AAAAFF" />
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#C8C8FF" />
            <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFFFFF" />

            <!-- Tabs drawn like WoW's chat tabs: the selected one shares the chat frame's black and goes gold. -->
            <SolidColorBrush x:Key="SelectorBarItemPillFill" Color="Transparent" />
            <SolidColorBrush x:Key="SelectorBarItemForeground" Color="#9D9D9D" />
            <SolidColorBrush x:Key="SelectorBarItemForegroundPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SelectorBarItemForegroundPressed" Color="#D8D8DE" />
            <SolidColorBrush x:Key="SelectorBarItemForegroundSelected" Color="#FFD100" />
            <SolidColorBrush x:Key="SelectorBarItemBackgroundSelected" Color="#99000000" />
            <SolidColorBrush x:Key="SelectorBarItemBackgroundPointerOver" Color="#4D000000" />

            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />

            <!--
                Chat Log, the design system shared with speakforever.app: black chat frames over a dark world,
                and the colours of WoW's chat channels and item qualities, each with one job.
            -->
            <SolidColorBrush x:Key="WorldBrush" Color="#1A1A1E" />      <!-- the window's ground -->
            <SolidColorBrush x:Key="PanelBrush" Color="#99000000" />    <!-- the chat frame: cards and panels -->
            <SolidColorBrush x:Key="TooltipBrush" Color="#0D0D1C" />    <!-- the one framed panel per screen -->
            <SolidColorBrush x:Key="InkBrush" Color="#000000" />        <!-- text on the action colour, outlines -->
            <SolidColorBrush x:Key="KeyBrush" Color="#0A0A0C" />        <!-- keycaps -->
            <SolidColorBrush x:Key="LineBrush" Color="#2E2E36" />       <!-- dividers -->
            <SolidColorBrush x:Key="EdgeBrush" Color="#8C8C99" />       <!-- tooltip and control borders -->
            <SolidColorBrush x:Key="SayBrush" Color="#FFFFFF" />        <!-- headings, names, strong text -->
            <SolidColorBrush x:Key="TextBrush" Color="#D8D8DE" />       <!-- body -->
            <SolidColorBrush x:Key="MutedBrush" Color="#9D9D9D" />      <!-- labels, metadata -->
            <SolidColorBrush x:Key="ActionBrush" Color="#FF8000" />     <!-- Legendary: the one thing to do next -->
            <SolidColorBrush x:Key="ReadyBrush" Color="#40FF40" />      <!-- Guild: ready -->
            <SolidColorBrush x:Key="ProblemBrush" Color="#FF4040" />    <!-- Yell: problems -->
            <SolidColorBrush x:Key="GoldBrush" Color="#FFD100" />       <!-- the selected tab, notices -->
            <SolidColorBrush x:Key="LinkBrush" Color="#AAAAFF" />       <!-- Party: links, listening -->

            <!-- The Home tab's status light, by tone: the colour, and the fill behind the microphone. -->
            <SolidColorBrush x:Key="ToneReadyBrush" Color="#40FF40" />
            <SolidColorBrush x:Key="ToneReadyFillBrush" Color="#0B240D" />
            <SolidColorBrush x:Key="ToneBusyBrush" Color="#AAAAFF" />
            <SolidColorBrush x:Key="ToneBusyFillBrush" Color="#16162E" />
            <SolidColorBrush x:Key="ToneIdleBrush" Color="#9D9D9D" />
            <SolidColorBrush x:Key="ToneIdleFillBrush" Color="#1F1F24" />
            <SolidColorBrush x:Key="ToneProblemBrush" Color="#FF4040" />
            <SolidColorBrush x:Key="ToneProblemFillBrush" Color="#2E1214" />

            <!-- Grenze for the name and headings, Sofia Sans for reading, its condensed cut for everything you operate. -->
            <FontFamily x:Key="Grenze">ms-appx:///Assets/Fonts/Grenze.ttf#Grenze</FontFamily>
            <FontFamily x:Key="SofiaSans">ms-appx:///Assets/Fonts/SofiaSans.ttf#Sofia Sans</FontFamily>
            <FontFamily x:Key="SofiaSansCondensed">ms-appx:///Assets/Fonts/SofiaSansCondensed.ttf#Sofia Sans Condensed</FontFamily>
            <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/SofiaSansCondensed.ttf#Sofia Sans Condensed</FontFamily>

            <!-- Square frames, 2px corners on what you press. -->
            <CornerRadius x:Key="ControlCornerRadius">2</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">2</CornerRadius>

            <!-- Stock controls (focus, check boxes, progress), in the action colour. -->
            <Color x:Key="SystemAccentColor">#FF8000</Color>
            <Color x:Key="SystemAccentColorLight1">#FF8000</Color>
            <Color x:Key="SystemAccentColorLight2">#FF8000</Color>
            <Color x:Key="SystemAccentColorLight3">#FF9933</Color>
            <Color x:Key="SystemAccentColorDark1">#E67300</Color>
            <Color x:Key="SystemAccentColorDark2">#CC6600</Color>
            <Color x:Key="SystemAccentColorDark3">#994C00</Color>

            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource SofiaSans}" />
            </Style>
            <Style TargetType="RichTextBlock">
                <Setter Property="FontFamily" Value="{StaticResource SofiaSans}" />
            </Style>

            <!-- The one framed panel per screen, like a WoW tooltip: silver edge, black inner line. -->
            <Style x:Key="Frame" TargetType="ContentControl">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="16,12,16,14" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContentControl">
                            <Border Background="{StaticResource TooltipBrush}" BorderBrush="{StaticResource EdgeBrush}" BorderThickness="1" CornerRadius="2">
                                <Border BorderBrush="{StaticResource InkBrush}" BorderThickness="1" CornerRadius="1" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                                </Border>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Everyday panels: the chat frame, square and borderless. -->
            <Style x:Key="Card" TargetType="ContentControl">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="16,14" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContentControl">
                            <Border Background="{StaticResource PanelBrush}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A section title in a panel: "Microphone", "Updates". -->
            <Style x:Key="FrameHeader" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource Grenze}" />
                <Setter Property="FontSize" Value="21" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource SayBrush}" />
            </Style>

            <!-- A small label over a group, such as "Last message". -->
            <Style x:Key="Label" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource SofiaSansCondensed}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            </Style>

            <!-- A title in a row or a card: "Turbo", "Say hello". -->
            <Style x:Key="ItemTitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource SofiaSansCondensed}" />
                <Setter Property="FontSize" Value="17" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource SayBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="Caption" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource SofiaSansCondensed}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- Caption, for text with controller button icons in it. -->
            <Style x:Key="RichCaption" TargetType="RichTextBlock">
                <Setter Property="FontFamily" Value="{StaticResource SofiaSansCondensed}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="IsTextSelectionEnabled" Value="False" />
            </Style>

            <!--
                Buttons in three tiers: AccentButton for the one thing to do next, PanelButton for
                everything else, QuietButton for links and small actions. They share one template:
                hovering lightens whatever colours the tier has, pressing darkens them.
            -->
            <Style x:Key="PanelButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{StaticResource EdgeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource SayBrush}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="14,7,14,8" />
                <Setter Property="MinWidth" Value="88" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                                <Border x:Name="Tint" CornerRadius="1" />
                                <ContentPresenter x:Name="Presenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Foreground="{TemplateBinding Foreground}" Padding="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Tint.Background" Value="#26FFFFFF" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Tint.Background" Value="#40000000" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Opacity" Value="0.4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource PanelButton}">
                <Setter Property="Background" Value="{StaticResource ActionBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource ActionBrush}" />
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Padding" Value="18,8,18,9" />
                <Setter Property="MinHeight" Value="40" />
            </Style>

            <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource PanelButton}">
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource LinkBrush}" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="MinWidth" Value="0" />
            </Style>

            <Style x:Key="Keycap" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource KeyBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource EdgeBrush}" />
                <Setter Property="BorderThickness" Value="1,1,1,3" />
                <Setter Property="CornerRadius" Value="2" />
                <Setter Property="Padding" Value="10,5" />
                <Setter Property="MinWidth" Value="130" />
                <Setter Property="MinHeight" Value="38" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="KeycapText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource SofiaSansCondensed}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource SayBrush}" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
