root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{csproj,props,targets,xml,xaml,slnx,manifest,json}]
indent_size = 2

[*.{xaml}]
indent_size = 4

[*.cs]
# ---- House style (enforced in the build by EnforceCodeStyleInBuild) --------------------------
csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.IDE0161.severity = warning

# Private members omit "private", as throughout the codebase.
dotnet_style_require_accessibility_modifiers = omit_if_default:warning
dotnet_diagnostic.IDE0040.severity = warning

csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning
dotnet_diagnostic.IDE0003.severity = warning

csharp_prefer_braces = when_multiline:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true

# Unused usings, unused private members, unread assignments.
dotnet_diagnostic.IDE0005.severity = warning
dotnet_diagnostic.IDE0051.severity = warning
dotnet_diagnostic.IDE0052.severity = warning

# Namespaces follow folders.
dotnet_style_namespace_match_folder = true
dotnet_diagnostic.IDE0130.severity = warning

# Naming: PascalCase for types, members, constants and static readonly fields; camelCase for
# other private fields (no underscore prefix).
dotnet_diagnostic.IDE1006.severity = warning

dotnet_naming_rule.constants_pascal.severity = warning
dotnet_naming_rule.constants_pascal.symbols = constants
dotnet_naming_rule.constants_pascal.style = pascal_case
dotnet_naming_symbols.constants.applicable_kinds = field, local
dotnet_naming_symbols.constants.required_modifiers = const

dotnet_naming_rule.static_readonly_pascal.severity = warning
dotnet_naming_rule.static_readonly_pascal.symbols = static_readonly_fields
dotnet_naming_rule.static_readonly_pascal.style = pascal_case
dotnet_naming_symbols.static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.static_readonly_fields.required_modifiers = static, readonly

dotnet_naming_rule.private_fields_camel.severity = warning
dotnet_naming_rule.private_fields_camel.symbols = private_fields
dotnet_naming_rule.private_fields_camel.style = camel_case
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.camel_case.capitalization = camel_case

# ---- Analyzer tuning ---------------------------------------------------------------------------
# XML docs are written where they help, not on every public member.
dotnet_diagnostic.CS1591.severity = none
# Parameters are documented where they need it, not every one in a signature.
dotnet_diagnostic.CS1573.severity = none

# The app is English-only and every format here is for display or logs, never parsed back
# (config is JSON, which is culture-invariant), so culture-specific overloads add noise, not safety.
dotnet_diagnostic.CA1305.severity = none
dotnet_diagnostic.CA1307.severity = none
dotnet_diagnostic.CA1309.severity = suggestion
dotnet_diagnostic.CA1310.severity = warning

# Plain Log.Info/Warn, not Microsoft.Extensions.Logging.
dotnet_diagnostic.CA1848.severity = none

# Forward cancellation tokens wherever a callee accepts one.
dotnet_diagnostic.CA2016.severity = warning

# Source-generated P/Invoke (LibraryImport) rather than runtime marshalling.
dotnet_diagnostic.SYSLIB1054.severity = warning

[app/Core/**.cs]
# The engine library never needs to come back to the caller's thread (the UI marshals for itself),
# so every await skips the synchronization context.
dotnet_diagnostic.CA2007.severity = warning

[**/{obj,bin}/**]
generated_code = true
